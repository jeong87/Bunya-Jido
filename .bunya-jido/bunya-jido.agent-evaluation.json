{
  "schema_version": "bunya-jido-agent-evaluation-v1",
  "project": {
    "name": "Bunya-Jido",
    "summary": "Acceptance cases for bounded coding-agent context generated from the committed self-map."
  },
  "limitation": "This deterministic suite verifies generated bounded context against authored expectations; it does not measure whether a live coding agent follows that context.",
  "cases": [
    {
      "id": "scanner-provenance-boundary",
      "dimension": "boundary_discipline",
      "query": {
        "task": "change scanner hint provenance"
      },
      "expect": {
        "route_status": "matched",
        "decision": "MATCH",
        "routes": [
          "change scanner hint provenance"
        ],
        "must_read": [
          "src/bunya_jido/scanner.py",
          "src/bunya_jido/blueprint.py",
          "docs/SCANNER_COVERAGE.md"
        ],
        "contracts": [
          "Provider hints from generated prompts, schemas, or viewer templates must not become Studio overlay landmarks."
        ],
        "tests": [
          "tests/test_scanner_coverage.py",
          "tests/test_blueprint_v2.py",
          "tests/test_gallery.py"
        ],
        "projection_context": [
          "projection:quality_contract"
        ]
      }
    },
    {
      "id": "route-projection-first-read",
      "dimension": "first_read_accuracy",
      "query": {
        "task": "change task route projection"
      },
      "expect": {
        "route_status": "matched",
        "decision": "MATCH",
        "routes": [
          "change task route projection"
        ],
        "forbid_routes": [
          "change grounding policy",
          "change viewer trust presentation"
        ],
        "must_read": [
          "src/bunya_jido/blueprint.py",
          "src/bunya_jido/viewer/index.template.html"
        ],
        "projection_context": [
          "projection:agent_navigation"
        ],
        "scenario_context": [
          "scenario:agent_context"
        ]
      }
    },
    {
      "id": "normal-bugfix-route-recovery",
      "dimension": "normal_bugfix_recovery",
      "query": {
        "task": "Fix conservative context decision routing behavior."
      },
      "expect": {
        "route_status": "matched",
        "decision": "MATCH",
        "execution_policy": "workspace_write",
        "routes": [
          "change task route projection"
        ],
        "must_read": [
          "src/bunya_jido/blueprint.py"
        ],
        "tests": [
          "tests/test_blueprint.py"
        ]
      }
    },
    {
      "id": "normal-bugfix-bounded-discovery",
      "dimension": "normal_bugfix_recovery",
      "query": {
        "task": "Fix CLI command dispatch for an unmapped option."
      },
      "expect": {
        "route_status": "not_found",
        "decision": "IN_SCOPE_NO_ROUTE",
        "execution_policy": "read_only_discovery",
        "routes": [],
        "discovery_nodes": [
          "entry:cli"
        ],
        "read_first": [
          "src/bunya_jido/cli.py"
        ]
      }
    },
    {
      "id": "viewer-test-recall",
      "dimension": "test_recall",
      "query": {
        "task": "change viewer presentation"
      },
      "expect": {
        "route_status": "matched",
        "decision": "MATCH",
        "routes": [
          "change viewer trust presentation"
        ],
        "tests": [
          "tests/test_smoke.py",
          "tests/test_blueprint.py",
          "tests/test_blueprint_v2.py",
          "tests/test_studio_benchmark.py"
        ],
        "projection_context": [
          "projection:trusted_publication"
        ],
        "scenario_context": [
          "scenario:publish_map",
          "scenario:agent_context"
        ]
      }
    },
    {
      "id": "grounding-boundary-discipline",
      "dimension": "boundary_discipline",
      "query": {
        "task": "change grounding policy"
      },
      "expect": {
        "route_status": "matched",
        "decision": "MATCH",
        "routes": [
          "change grounding policy"
        ],
        "forbid_routes": [
          "change viewer trust presentation"
        ],
        "contracts": [
          "Core node and critical edge evidence must remain inspectable before semantic publication."
        ],
        "safe_edit": [
          "src/bunya_jido/blueprint.py",
          "tests/test_blueprint.py"
        ]
      }
    },
    {
      "id": "atlas-quality-judgment-boundary",
      "dimension": "boundary_discipline",
      "query": {
        "task": "change atlas quality evaluation"
      },
      "expect": {
        "route_status": "matched",
        "decision": "MATCH",
        "routes": [
          "change atlas quality evaluation"
        ],
        "must_read": [
          "src/bunya_jido/quality.py",
          "src/bunya_jido/schema.py"
        ],
        "contracts": [
          "Deterministic blockers and warnings must remain separate from review-required editorial judgments."
        ],
        "tests": [
          "tests/test_projection_quality.py",
          "tests/test_studio_benchmark.py"
        ]
      }
    },
    {
      "id": "benchmark-token-reporting-boundary",
      "dimension": "boundary_discipline",
      "query": {
        "task": "change benchmark token reporting"
      },
      "expect": {
        "route_status": "matched",
        "decision": "MATCH",
        "routes": [
          "change benchmark evidence reporting"
        ],
        "forbid_routes": [
          "change multi-domain rubric coverage",
          "change task route projection"
        ],
        "must_read": [
          "src/bunya_jido/benchmark.py",
          "docs/BENCHMARK_RESULT_CONTRACT.md"
        ],
        "contracts": [
          "Token-saving comparisons must include only paired safe-and-resolved runs from compatible conditions."
        ],
        "tests": [
          "tests/test_benchmark_audit.py"
        ],
        "projection_context": [
          "projection:quality_contract"
        ]
      }
    },
    {
      "id": "multi-domain-rubric-does-not-seed-domain-vocabulary",
      "dimension": "boundary_discipline",
      "query": {
        "task": "change multi-domain rubric coverage"
      },
      "expect": {
        "route_status": "matched",
        "decision": "MATCH",
        "routes": [
          "change multi-domain rubric coverage"
        ],
        "must_read": [
          "docs/STUDIO_BENCHMARK.md",
          "tests/fixtures/studio_benchmark_cases.json",
          "src/bunya_jido/studio.py"
        ],
        "contracts": [
          "Benchmark fixtures must demonstrate differing repository shapes without turning an external reference atlas into a prompt seed."
        ],
        "tests": [
          "tests/test_studio_benchmark.py"
        ]
      }
    },
    {
      "id": "unknown-registry-task-honest-no-match",
      "dimension": "honest_no_match",
      "query": {
